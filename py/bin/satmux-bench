#!/usr/bin/env python3
"""
satmux-bench: Clean side-by-side live terminal benchmark for tweet screenshots.
Compares RAW Inflight Wi-Fi (:443 Proxy) vs 12× Warm BBR + 1-RTT Ground-TLS + zlib Sat-Mux.
Zero personal hostnames, IPs, or secrets are displayed.
"""
import concurrent.futures
import subprocess
import sys
import time
import zlib

BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[38;5;203m"
YLW = "\033[38;5;221m"
GRN = "\033[38;5;84m"
CYN = "\033[38;5;117m"
MAG = "\033[38;5;183m"
GRY = "\033[38;5;244m"
RST = "\033[0m"

TARGETS = [
    ("GitHub Repo", "https://github.com/leanprover/lean4"),
    ("GitHub API", "https://api.github.com/repos/torvalds/linux"),
    ("Hacker News", "https://news.ycombinator.com/"),
    ("MDN Docs", "https://developer.mozilla.org/en-US/"),
    ("Cloudflare", "https://www.cloudflare.com/cdn-cgi/trace"),
    ("PyPI JSON API", "https://pypi.org/pypi/httpx/json"),
]


def probe_one(url: str, via_mux: bool, timeout_s: float = 14.0):
    t0 = time.perf_counter()
    cmd = [
        "curl",
        "-sS",
        "-L",
        "--noproxy",
        "*",
        "--max-time",
        f"{timeout_s:.0f}",
        "-o",
        "/dev/null",
        "-w",
        "%{http_code} %{time_starttransfer} %{time_total} %{size_download}",
    ]
    target = f"http://127.0.0.1:8081/{url}" if via_mux else url
    cmd.append(target)
    p = subprocess.run(cmd, capture_output=True, text=True)
    wall = time.perf_counter() - t0
    parts = p.stdout.strip().split()
    if p.returncode != 0 or len(parts) != 4 or parts[0] == "000":
        err = "TCP RESET" if p.returncode in (35, 56, 7) else ("TIMEOUT" if p.returncode == 28 else f"ERR({p.returncode})")
        return {"ok": False, "err": err, "total": wall, "ttfb": wall, "bytes": 0}
    code = int(parts[0])
    t_ttfb = float(parts[1])
    t_tot = float(parts[2])
    sz = int(float(parts[3]))
    return {
        "ok": 200 <= code < 400,
        "err": f"HTTP {code}",
        "total": t_tot,
        "ttfb": t_ttfb,
        "bytes": sz,
    }


def bar(val: float, max_val: float, width: int = 12, color: str = GRN) -> str:
    filled = max(1, min(width, int(round((val / max_val) * width))))
    return f"{color}{'█' * filled}{GRY}{'░' * (width - filled)}{RST}"


def run_burst(via_mux: bool):
    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex:
        futs = [(name, ex.submit(probe_one, url, via_mux)) for name, url in TARGETS]
        rows = [(name, f.result()) for name, f in futs]
    wall = time.perf_counter() - t0
    return rows, wall


def main():
    print()
    print(f"  {BOLD}{CYN}╭──────────────────────────────────────────────────────────────────────────────────╮{RST}")
    print(f"  {BOLD}{CYN}│{RST}  {BOLD}✈️  INFLIGHT GEO SATELLITE BENCHMARK{RST}   {DIM}·  Inmarsat GX Ka-band (~620 ms RTT){RST}     {BOLD}{CYN}│{RST}")
    print(f"  {BOLD}{CYN}│{RST}  {GRY}Direct Cabin Wi-Fi (:443 PEP)  vs  12× Warm BBR + 1-RTT Ground-TLS + zlib{RST}       {BOLD}{CYN}│{RST}")
    print(f"  {BOLD}{CYN}╰──────────────────────────────────────────────────────────────────────────────────╯{RST}")
    print()

    sys.stdout.write(f"  {DIM}[1/2] Probing 6 concurrent TLS origins via 12× Warm 1-RTT Sat-Mux...{RST}\r")
    sys.stdout.flush()
    mux_rows, mux_wall = run_burst(via_mux=True)
    sys.stdout.write(" " * 82 + "\r")

    sys.stdout.write(f"  {DIM}[2/2] Probing 6 concurrent TLS origins via RAW cabin Wi-Fi (:443)...{RST}\r")
    sys.stdout.flush()
    raw_rows, raw_wall = run_burst(via_mux=False)
    sys.stdout.write(" " * 82 + "\r")

    print(f"  {BOLD}{'ORIGIN (6× PARALLEL)':<20}  {'RAW CABIN WI-FI (:443)':<24}  {'1-RTT BBR + ZLIB MUX':<22}  {'SPEEDUP'}{RST}")
    print(f"  {GRY}{'─' * 20}  {'─' * 24}  {'─' * 22}  {'─' * 9}{RST}")

    max_t = max(
        max(r["total"] for _, r in raw_rows),
        max(r["total"] for _, r in mux_rows),
        1.0,
    )

    raw_fails = 0
    mux_fails = 0
    for (name, r_raw), (_, r_mux) in zip(raw_rows, mux_rows):
        if r_raw["ok"]:
            raw_cell = f"{bar(r_raw['total'], max_t, 12, RED)} {RED}{r_raw['total']:>9.2f}s{RST}"
        else:
            raw_fails += 1
            raw_cell = f"{bar(max_t, max_t, 12, RED)} {RED}{BOLD}{r_raw['err']:>10}{RST}"

        if r_mux["ok"]:
            mux_cell = f"{bar(r_mux['total'], max_t, 12, GRN)} {GRN}{r_mux['total']:>7.2f}s{RST}"
        else:
            mux_fails += 1
            mux_cell = f"{bar(max_t, max_t, 12, YLW)} {YLW}{r_mux['err']:>8}{RST}"

        if r_raw["ok"] and r_mux["ok"] and r_mux["total"] > 0:
            sp = r_raw["total"] / r_mux["total"]
            gain = f"{BOLD}{GRN}{sp:>6.1f}×{RST}"
        elif not r_raw["ok"] and r_mux["ok"]:
            gain = f"{BOLD}{CYN}FIXED ✓{RST}"
        else:
            gain = f"{GRY}   n/a{RST}"

        print(f"  {name:<20}  {raw_cell}  {mux_cell}  {gain}")

    total_bytes = sum(r["bytes"] for _, r in mux_rows)
    avg_raw_ttfb = sum(r["ttfb"] for _, r in raw_rows) / len(raw_rows)
    avg_mux_ttfb = sum(r["ttfb"] for _, r in mux_rows) / len(mux_rows)
    ttfb_saved = max(0.0, (1.0 - (avg_mux_ttfb / avg_raw_ttfb)) * 100.0) if avg_raw_ttfb > 0 else 0.0
    wall_speedup = raw_wall / mux_wall if mux_wall > 0 else 1.0

    print(f"  {GRY}{'─' * 82}{RST}")
    print(
        f"  {BOLD}6-Origin Burst:{RST}    "
        f"{RED}{raw_wall:.2f}s ({raw_fails}/6 failed){RST}  →  "
        f"{GRN}{BOLD}{mux_wall:.2f}s ({mux_fails}/6 failed){RST}   "
        f"{BOLD}{MAG}[{wall_speedup:.1f}× faster · -{ttfb_saved:.0f}% TTFB]{RST}"
    )
    print(
        f"  {BOLD}Tunnel Stack:{RST}      "
        f"{DIM}12× warm TCP pipes · 0-RTT Open · 1-RTT Ground-TLS · Linux BBR · zlib(6){RST}"
    )
    print(
        f"  {BOLD}Payload Delivered:{RST} "
        f"{DIM}{total_bytes / 1024:.0f} KB uncompressed (~{total_bytes / 1024 * 0.22:.0f} KB on satellite wire via $0.03/h EU VM){RST}"
    )
    print()


if __name__ == "__main__":
    main()
